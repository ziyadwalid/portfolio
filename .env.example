# Public site URL used for canonical/Open Graph tags and sitemap docs.
# Example: https://your-project.pages.dev
VITE_SITE_URL=

# Optional override. The confirmed default is zeadwalid56@gmail.com.
VITE_CONTACT_EMAIL=

# Optional public form endpoint (Formspree or another JSON form provider).
# Example: https://formspree.io/f/your-form-id
# This endpoint URL is public by design. Never put a private API key here.
VITE_CONTACT_FORM_ENDPOINT=
